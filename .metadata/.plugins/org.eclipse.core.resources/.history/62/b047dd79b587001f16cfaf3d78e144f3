                Loop claimLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2000B").getLoop("2300");
                if (claimLoop == null) {
                    System.out.println("Claim loop not found.");
                    continue;
                }
 
                // Extract claim details from CLM segment
                Segment clmSegment = claimLoop.getSegment("CLM");
                if (clmSegment != null) {
                    // Create a new Claim resource
                    Claim claim = new Claim();
 
                    // Set claim ID (from CLM01)
                    String claimId = clmSegment.getElementValue("CLM01");
                    claim.setId(claimId);
 
                    // Set the patient reference (assuming already created Patient resource)
                    claim.setPatient(new Reference("Patient/123"));
 
                    // Set total claim amount (CLM02)
                    String totalChargeAmount = clmSegment.getElementValue("CLM02");
                    claim.setTotal(new Money().setValue(Double.parseDouble(totalChargeAmount)).setCurrency("USD"));
 
                    // Set claim type (professional/institutional based on CLM05-1)
                    String claimTypeCode = clmSegment.getElementValue("CLM05");
                    
                    claimTypeCode= claimTypeCode.substring(0, 2);
                    System.out.println(claimTypeCode);
                    
                    CodeableConcept typeCode = new CodeableConcept();
                    if (claimTypeCode.equals("11")) {
                        typeCode.addCoding(new Coding("http://terminology.hl7.org/CodeSystem/claim-type", "professional", "Professional Claim"));
                    } else if (claimTypeCode.equals("12")) {
                        typeCode.addCoding(new Coding("http://terminology.hl7.org/CodeSystem/claim-type", "institutional", "Institutional Claim"));
                    }
                    claim.setType(typeCode);
 
                    // Extract additional information from related segments (e.g., REF, DTP)
                    // REF segment (e.g., REF*D9 - Claim Number)
                    Segment refSegment = claimLoop.getSegment("REF");
                    if (refSegment != null) {
                        String claimNumber = refSegment.getElementValue("REF02");
                        claim.addIdentifier().setSystem("http://example.org/claim-number").setValue(claimNumber);
                    }
 
                    // DTP segment (e.g., DTP*431 - Date of Service)
//                    Segment dtpSegment = claimLoop.getSegment("DTP");
//                    if (dtpSegment != null && "431".equals(dtpSegment.getElementValue("DTP01"))) {
//                        String dateOfService = dtpSegment.getElementValue("DTP03");
//                        claim.setBillablePeriod(new Period().setStartElement(new DateType(dateOfService)));
//                    }
 
                    // Add diagnosis information (e.g., from HI segment)
                    Segment hiSegment = claimLoop.getSegment("HI");
                    if (hiSegment != null) {
                        DiagnosisComponent diagnosis = new DiagnosisComponent();
                        diagnosis.setSequence(1);  // Assuming first diagnosis
 
                        String diagnosisCode = hiSegment.getElementValue("HI01-2");
                        diagnosis.setDiagnosis(new CodeableConcept().addCoding(
                            new Coding("http://hl7.org/fhir/sid/icd-10", diagnosisCode, "Diagnosis")
                        ));
 
                        claim.addDiagnosis(diagnosis);
                    }
 
                    // Add service line item (e.g., LX and SV2 segments)
                    Loop serviceLineLoop = claimLoop.getLoop("2400");
                    if (serviceLineLoop != null) {
                        Segment sv2Segment = serviceLineLoop.getSegment("SV2");
                        if (sv2Segment != null) {
                            ItemComponent item = new ItemComponent();
                            item.setSequence(1);  // Assuming first service line
 
                            String procedureCode = sv2Segment.getElementValue("SV202-1");
                            item.setProductOrService(new CodeableConcept().addCoding(
                                new Coding("http://hl7.org/fhir/sid/cpt", procedureCode, "Procedure")
                            ));
 
                            String chargeAmount = sv2Segment.getElementValue("SV203");
                            item.setUnitPrice(new Money().setValue(Double.parseDouble(chargeAmount)).setCurrency("USD"));
 
                            claim.addItem(item);
                        }
                    }
 
                    // Serialize the claim resource to a JSON string
                    String claimJson = ctx.newJsonParser().setPrettyPrint(true).encodeResourceToString(claim);
 
                    // Print the JSON output
                    System.out.println(claimJson);
                }
                
//      -------------------------------practitioner 
             // Adding Practitioner Resource
                Loop practitionerLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2310B");
                Segment practitionerSegment = practitionerLoop.getSegment("NM1");

                if (practitionerSegment != null) {
                    // Create a new Practitioner resource
                    Practitioner practitioner = new Practitioner();
                    String practitionerId = practitionerSegment.getElementValue("NM109");  // NPI or unique ID
                    practitioner.setId(practitionerId);

                    // Set practitioner name
                    String practitionerLastName = practitionerSegment.getElementValue("NM103");
                    String practitionerFirstName = practitionerSegment.getElementValue("NM104");
                    HumanName practitionerName = practitioner.addName();
                    practitionerName.setFamily(practitionerLastName);
                    practitionerName.addGiven(practitionerFirstName);

                    // Add telecom information (if available, use PER segment)
                    Loop contactLoop = practitionerLoop.getLoop("PER");
                    if (contactLoop != null) {
                        Segment contactSegment = contactLoop.getSegment("PER");
                        if (contactSegment != null) {
                            practitioner.addTelecom()
                                    .setSystem(ContactPoint.ContactPointSystem.PHONE)
                                    .setValue(contactSegment.getElementValue("PER04"))
                                    .setUse(ContactPoint.ContactPointUse.WORK);
                        }
                    }

                    // Serialize and print the Practitioner resource
                    String practitionerJson = ctx.newJsonParser().setPrettyPrint(true).encodeResourceToString(practitioner);
                    System.out.println(practitionerJson);
                }

       
                
      //coverage ---------------------------------          
                
                
             // Adding Coverage Resource
                Loop subscriberLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2000B").getLoop("2010BA");
                Segment subscriberSegment = subscriberLoop.getSegment("NM1");

                if (subscriberSegment != null) {
                    // Create a new Coverage resource
                    Coverage coverage = new Coverage();
                    coverage.setId("coverage-123");  // Unique ID for coverage

                    // Set the coverage type (e.g., insurance)
                    CodeableConcept coverageType = new CodeableConcept();
                    coverageType.addCoding(new Coding("http://terminology.hl7.org/CodeSystem/coverage-class", "insurance", "Insurance"));
                    coverage.setType(coverageType);

                    // Set the beneficiary (the patient)
                    String subscriberId = subscriberSegment.getElementValue("NM109"); // Subscriber ID
                    coverage.setBeneficiary(new Reference("Patient/" + patientId));

                    // Set coverage period (use DMG or DTP segment for coverage dates if available)
                    Period coveragePeriod = new Period();
                    coveragePeriod.setStart(new DateType("2023-01-01").getValue());  // Placeholder
                    coveragePeriod.setEnd(new DateType("2023-12-31").getValue());    // Placeholder
                    coverage.setPeriod(coveragePeriod);

                    // Set payer organization (use loop 2010BB for payer information)
                    Loop payerLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2010BB");
                    if (payerLoop != null) {
                        Segment payerSegment = payerLoop.getSegment("NM1");
                        if (payerSegment != null) {
                            String payerId = payerSegment.getElementValue("NM109");
                            coverage.setPayor(List.of(new Reference("Organization/" + payerId)));
                        }
                    }

                    // Serialize and print the Coverage resource
                    String coverageJson = ctx.newJsonParser().setPrettyPrint(true).encodeResourceToString(coverage);
                    System.out.println(coverageJson);
                }

//       ------------------------Encounter-------------------
                
                
             // Adding Encounter Resource
                Loop encounterLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2300");
                Segment clmSegmentForEncounter = encounterLoop.getSegment("CLM");

                if (clmSegmentForEncounter != null) {
                    // Create a new Encounter resource
                    Encounter encounter = new Encounter();
                    encounter.setId("encounter-456");  // Unique ID for the encounter

                    // Set patient reference
                    encounter.setSubject(new Reference("Patient/" + patientId));

                    // Set encounter status (e.g., finished, in-progress)
                    encounter.setStatus(Encounter.EncounterStatus.FINISHED);

                    // Set encounter type (use CLM05-1 to identify)
                    String claimTypeCodeForEncounter = clmSegmentForEncounter.getElementValue("CLM05");
                    CodeableConcept encounterType = new CodeableConcept();
                    if (claimTypeCodeForEncounter != null && claimTypeCodeForEncounter.startsWith("11")) {
                        encounterType.addCoding(new Coding("http://terminology.hl7.org/CodeSystem/encounter-type", "ambulatory", "Ambulatory"));
                    } else if (claimTypeCodeForEncounter.startsWith("12")) {
                        encounterType.addCoding(new Coding("http://terminology.hl7.org/CodeSystem/encounter-type", "inpatient", "Inpatient"));
                    }
                    encounter.setType(List.of(encounterType));

                    // Set encounter period (from DTP segment)
                    Segment dtpSegmentForEncounter = encounterLoop.getSegment("DTP");
                    if (dtpSegmentForEncounter != null) {
                        String encounterStartDate = dtpSegmentForEncounter.getElementValue("DTP03");
                        Period encounterPeriod = new Period();
                        encounterPeriod.setStart(new DateType(encounterStartDate).getValue());
                        encounter.setPeriod(encounterPeriod);
                    }

                    // Serialize and print the Encounter resource
                    String encounterJson = ctx.newJsonParser().setPrettyPrint(true).encodeResourceToString(encounter);
                    System.out.println(encounterJson);
                }
     
                
               
                
                
                
            }//loop
                
 
            
