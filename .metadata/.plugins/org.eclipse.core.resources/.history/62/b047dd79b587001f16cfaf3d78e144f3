public class MappingsClass {
 
    public static void main(String[] args) {
        FhirContext ctx = FhirContext.forR4();
 
        
        System.out.println("hello");
        try {

            File f1 = new File("C:\\Users\\DELL\\Downloads\\EDIX12_837HealthCareClaim-Dummy.txt");
            

            
             
            // Create X12Reader with ANSI 837 5010 X223 format
            X12Reader reader = new X12Reader(FileType.ANSI837_5010_X223, f1);
 
            // Retrieve loops from the X12 file
            List<Loop> loops = reader.getLoops();
 
            System.out.println("Number of ISA-IEA transactions: " + loops.size());
 
            for (Loop loop : loops) {
                // Fetch patient details from Loop 2010BA (Subscriber) and 2000B
                Loop patientLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2000B").getLoop("2010BA");
                Segment patientNM1 = patientLoop.getSegment("NM1");
 
                // Extract patient name and gender from the X12 message
                String patientLastName = patientNM1.getElementValue("NM103");
                String patientFirstName = patientNM1.getElementValue("NM104");
                String patientGender = patientNM1.getElementValue("NM108");  // Assuming NM108 maps to gender
                String patientId = patientNM1.getElementValue("NM109");
 
                // Extract patient's birth date (DTP segment in Loop 2010BA)
                Segment patientDOB = patientLoop.getSegment("DMG");
                String patientBirthDate = patientDOB.getElementValue("DMG02");
 
                // Create a new Patient resource
                Patient patient = new Patient();
                patient.setId(patientId);
                patient.addIdentifier()
                        .setSystem("http://hospital.smarthealth.org/patients")
                        .setValue(patientId);
 
                // Add patient name
                HumanName name = patient.addName();
                name.setFamily(patientLastName);
                name.addGiven(patientFirstName);
 
                // Map patient gender from X12 to FHIR (assuming "M" = Male, "F" = Female)
                if (patientGender.equals("M")) {
                    patient.setGender(AdministrativeGender.MALE);
                } else if (patientGender.equals("F")) {
                    patient.setGender(AdministrativeGender.FEMALE);
                }
 
                // Set birth date
                patient.setBirthDateElement(new DateType(patientBirthDate));
 
                // Serialize and print the Patient resource
                String patientJson = ctx.newJsonParser().setPrettyPrint(true).encodeResourceToString(patient);
                System.out.println(patientJson);
 
// ---------------------------------------------------------------------------------------
