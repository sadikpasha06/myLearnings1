//                String claimJson = ctx.newJsonParser().setPrettyPrint(true).encodeResourceToString(claim);
//                System.out.println(claimJson);
//
                
                
                
   //---------------------------------------------------------------------------------------------------
                // Fetch practitioner details from Loop 2310B (Rendering Physician)
//                Loop practitionerLoop = loop.getLoop("GS_LOOP").getLoop("ST_LOOP").getLoop("2000B");
//                Segment practitionerNM1 = practitionerLoop.getSegment("NM1");
//
//                // Extract practitioner name and identifier
//                String practitionerLastName = practitionerNM1.getElementValue("NM103");
